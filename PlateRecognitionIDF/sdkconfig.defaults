CONFIG_IDF_TARGET="esp32s3"

# 8MB Octal PSRAM (N8R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# 8MB Flash (N8R8 是 8MB 四线 Flash + 8MB 八线 PSRAM, Flash 用 QIO)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# ESP-DL 官方推荐性能/内存配置
# 出处: managed_components/espressif__esp-dl/external_examples/9229b918/
#       model_in_flash_rodata/sdkconfig.defaults.esp32s3
# ESP-DL 的 dl_tie728_s8_* 汇编算子对 cache 配置与 CPU 频率有硬性要求
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n

# GC2145 取图模式 (P5.11): 默认的 SUBSAMPLE 模式是"传感器读 1280x960 窗口, 再 1/2 抽点丢像素"
#   (VGA 要 640x480, 即每 4 个像素只留 1 个, 不做平均) => 屏幕的像素网格与抽点网格打架, 摩尔纹/
#   伪结构在进我们算法之前就烙进图里了, 我们后面的面积平均只能抹平自己造成的走样。
#   WINDOWING 模式改成"从 1600x1200 里裁 640x480 出来", 1:1 不抽点 => 没有源端走样。
#   代价: 视野减半 (相对原来的 1280x960=80%x80% 取景), 车牌在画面里大一倍, 要拿远一点、更靠中间。
#   想退回原状: 把这两行换回 # CONFIG_GC_SENSOR_WINDOWING_MODE is not set / CONFIG_GC_SENSOR_SUBSAMPLE_MODE=y
CONFIG_GC_SENSOR_WINDOWING_MODE=y
# CONFIG_GC_SENSOR_SUBSAMPLE_MODE is not set

# P5.12: 串口要发图片 + 精简日志, 控制台从 115200 提到 921600
#   那边 BY串口助手也要把波特率选成 921600; 想退回 115200 就把这行删掉重新 build
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# P5.76: 默认全静音 —— 简单日志模式下只打"结果块"(自己 printf, 不走 ESP_LOG)。
#   开机那堆 (boot / esp_psram / cpu_start / heap_init) 在编译期就压掉; MAXIMUM 保持 INFO,
#   这样运行时 esp_log_level_set 还能把日志重新打开 (所以 MAXIMUM_EQUALS_DEFAULT 必须是 n)。
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y