### 替换3：`_build_cmd_frame` 方法

找到 `_build_cmd_frame` 方法，替换为：

```python
    def _build_cmd_frame(self, parent):
        self._cmd_frame = ttk.Frame(parent)
        # 由调用者用 grid 管理，不在内部 pack

        ttk.Label(self._cmd_frame, text="发送:").pack(side=tk.LEFT)

        self.cmd_fmt_var = tk.StringVar(value="ascii")
        fmt_box = ttk.Combobox(self._cmd_frame, textvariable=self.cmd_fmt_var,
                               values=["ascii", "hex"], width=5, state="readonly")
        fmt_box.pack(side=tk.LEFT, padx=(4, 0))

        self.cmd_entry = ttk.Entry(self._cmd_frame)
        self.cmd_entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(4, 4))
        self.cmd_entry.bind("<Return>", lambda e: self._send_cmd())

        self.cmd_nl_var = tk.StringVar(value="none")
        ttk.Combobox(self._cmd_frame, textvariable=self.cmd_nl_var,
                     values=["none", "\\n", "\\r", "\\n\\r"], width=5, state="readonly").pack(side=tk.LEFT, padx=(0, 4))

        ttk.Button(self._cmd_frame, text="发送", command=self._send_cmd).pack(side=tk.LEFT)
